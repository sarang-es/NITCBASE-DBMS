{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug nitcbase",
      "cwd": "${workspaceFolder}",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/nitcbase-debug",
      "stopAtEntry": false,
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build debug nitcbase",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}